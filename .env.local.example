# ============================================================
# 나온집 환경변수 예시
# - 실제 값은 .env.local 에 채워넣는다 (이 파일은 git 에 commit).
# - SECRET 류는 NEXT_PUBLIC_ 접두사 절대 금지 (클라이언트 번들에 노출됨).
# ============================================================

# ── Supabase (공개) ─────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ── Supabase (서버 전용, SECRET) ────────────────────────────
# /admin/reports 의 service_role 클라이언트 (supabase-admin.ts) 에서만 사용.
# 클라이언트 컴포넌트에서 import 하면 안 된다.
SUPABASE_SERVICE_ROLE_KEY=

# ── Admin 인증 (서버 전용, SECRET) ──────────────────────────
# /admin/** 보호용. 32자 이상 랜덤 문자열 권장.
# 예) openssl rand -hex 32
ADMIN_PASSWORD=

# ── Kakao Maps (공개) ───────────────────────────────────────
NEXT_PUBLIC_KAKAO_JAVASCRIPT_KEY=

# ── (선택) 외부 신고 폼 fallback URL ────────────────────────
# 비워두면 외부 폼 링크가 노출되지 않는다.
NEXT_PUBLIC_REPORT_FORM_URL=
